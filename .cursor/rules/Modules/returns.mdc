## Database Schema 📊

### Returns Table

```sql
CREATE TABLE returns (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  return_number TEXT UNIQUE NOT NULL,
  "order" UUID NOT NULL REFERENCES orders(id),
  fulfillment UUID REFERENCES fulfillments(id),
  customer UUID NOT NULL REFERENCES customers(id),
  market_currency UUID REFERENCES market_currencies(id),
  status TEXT NOT NULL CHECK (status IN ('REQUESTED', 'APPROVED', 'IN_TRANSIT', 'RECEIVED', 'INSPECTED', 'COMPLETED', 'REJECTED', 'CANCELLED')),
  type TEXT NOT NULL CHECK (type IN ('RETURN', 'EXCHANGE')),
  reason TEXT CHECK (reason IN ('DEFECTIVE', 'SIZE_FIT', 'WRONG_ITEM', 'NOT_AS_DESCRIBED', 'CHANGED_MIND', 'OTHER')),
  resolution TEXT CHECK (resolution IN ('REFUND', 'EXCHANGE', 'STORE_CREDIT')),
  location UUID REFERENCES locations(id),
  tracking_number TEXT,
  tracking_link TEXT,
  carrier TEXT,
  customer_note TEXT,
  internal_note TEXT,
  inspection_note TEXT,
  rejection_reason TEXT,
  policy_window_days INTEGER,
  auto_approved BOOLEAN DEFAULT false,
  restocking_fee_percentage NUMERIC(5,2) DEFAULT 0,
  refund_shipping_cost BOOLEAN DEFAULT false,
  total_refund_amount NUMERIC(10,2) DEFAULT 0,
  restocking_fee_amount NUMERIC(10,2) DEFAULT 0,
  shipping_refund_amount NUMERIC(10,2) DEFAULT 0,
  currency TEXT,
  refund_processed BOOLEAN DEFAULT false,
  refund_processed_at TIMESTAMP WITH TIME ZONE,
  refund_method TEXT CHECK (refund_method IN ('ORIGINAL_PAYMENT', 'BANK_TRANSFER', 'MANUAL', 'STORE_CREDIT')),
  refund_payment_id UUID REFERENCES payments(id),
  requested_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  approved_at TIMESTAMP WITH TIME ZONE,
  rejected_at TIMESTAMP WITH TIME ZONE,
  shipped_at TIMESTAMP WITH TIME ZONE,
  received_at TIMESTAMP WITH TIME ZONE,
  inspected_at TIMESTAMP WITH TIME ZONE,
  completed_at TIMESTAMP WITH TIME ZONE,
  cancelled_at TIMESTAMP WITH TIME ZONE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);
```

### Return Items Table

```sql
CREATE TABLE return_items (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  "return" UUID NOT NULL REFERENCES returns(id) ON DELETE CASCADE,
  order_item UUID NOT NULL REFERENCES order_item(id),
  variant UUID NOT NULL REFERENCES product_variants(id),
  quantity_requested INTEGER NOT NULL,
  quantity_received INTEGER DEFAULT 0,
  quantity_approved INTEGER DEFAULT 0,
  condition TEXT CHECK (condition IN ('NEW', 'LIKE_NEW', 'GOOD', 'FAIR', 'DAMAGED')),
  resalable BOOLEAN,
  product_title TEXT,
  variant_title TEXT,
  product_sku TEXT,
  variant_sku TEXT,
  original_price NUMERIC(10,2),
  refund_amount NUMERIC(10,2),
  exchange_for_variant UUID REFERENCES product_variants(id),
  action_taken TEXT,
  inspection_notes TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);
```

### Return Policies Table

```sql
CREATE TABLE return_policies (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  market TEXT NOT NULL REFERENCES markets(id),
  return_window_days INTEGER NOT NULL DEFAULT 30,
  auto_approve BOOLEAN DEFAULT false,
  auto_process_refund BOOLEAN DEFAULT false,
  require_original_packaging BOOLEAN DEFAULT false,
  restocking_fee_enabled BOOLEAN DEFAULT false,
  restocking_fee_percentage NUMERIC(5,2) DEFAULT 0,
  refund_shipping_cost BOOLEAN DEFAULT true,
  free_return_shipping BOOLEAN DEFAULT false,
  non_returnable_types TEXT[] DEFAULT ARRAY['gift_card'],
  accept_opened_items BOOLEAN DEFAULT true,
  accept_used_items BOOLEAN DEFAULT false,
  is_active BOOLEAN DEFAULT true,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  UNIQUE(market)
);
```

