## Core Functions 🛠

### Create Return Function

```javascript
const { createReturn } = require('./functions/returns/create');

const returnRecord = await createReturn({
  order: 'order-uuid',
  type: 'RETURN',
  reason: 'SIZE_FIT',
  items: [
    {
      order_item: 'order-item-uuid',
      quantity_requested: 1
    }
  ],
  customer_note: 'Size too small'
});

console.log(`Return created: ${returnRecord.return_number}`);
```

### Query Returns Function

```javascript
const { queryReturns } = require('./functions/returns/query');

const result = await queryReturns({
  status: 'REQUESTED',
  expand: 'customer,order,items',
  orderBy: 'requested_at',
  ascending: true,
  page: 1,
  limit: 20
});

console.log(`Found ${result.returns.length} pending returns`);
```

### Complete Return Function

```javascript
const { completeReturn } = require('./functions/returns/complete');

const returnRecord = await completeReturn('return-uuid', {
  auto_process_refund: true,
  refund_method: 'ORIGINAL_PAYMENT',
  internal_note: 'Return completed successfully'
});

console.log(`Refund amount: ${returnRecord.total_refund_amount}`);
```

