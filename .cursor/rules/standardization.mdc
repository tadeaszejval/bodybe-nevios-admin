### API Response Structure Reference

#### Order Response Structure
```javascript
{
  // Core fields
  id, name, status, payment_status, fulfillment_status,
  inventory_status, local_currency, created_at,
  
  // Expanded relations
  customer: { id, first_name, last_name, email, ... },
  items: [{ id, product_title, quantity, pricing: {...} }],
  
  // Nested pricing
  pricing: {
    components: [
      { component: 'subtotal', gross_local, net_local },
      { component: 'shipping', gross_local, net_local },
      { component: 'total', gross_local, net_local }
    ]
  },
  
  // JSONB snapshots (included by default)
  billing_address_log: { first_name, address, city, ... },
  shipping_address_log: { first_name, address, city, type, ... },
  shipping_method: { name, type, price },
  payment_method: { name, type, price },
  
  // Arrays
  alerts: [{ key, level, value, action, order_item }],
  
  // Notes
  customer_note: "...",
  internal_note: "..."
}
```

#### Customer Response Structure
```javascript
{
  // Core fields
  id, email, first_name, last_name, phone, country,
  subscribed, account_enabled, gender, created_at,
  
  // Expanded arrays
  billing_addresses: [{ id, first_name, address, city, ... }],
  shipping_addresses: [{ id, first_name, address, city, type, ... }],
  orders: [{ id, name, payment_status, fulfillment_status, ... }],
  
  // References
  default_billing: "uuid",
  default_shipping: "uuid"
}
```

