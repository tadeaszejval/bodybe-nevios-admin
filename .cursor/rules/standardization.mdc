### Prohibited Patterns

**NEVER do these in view pages:**

```javascript
// ❌ Direct Supabase queries
import { supabase } from "../../../utils/supabase";
const { data } = await supabase.from('table')...

// ❌ Multiple useEffect for data fetching
useEffect(() => { fetchData1() }, [id]);
useEffect(() => { fetchData2() }, [id]);

// ❌ Manual state updates after actions
setRecord(prev => ({ ...prev, ...updates }));

// ❌ Unsafe data access without optional chaining
{record.customer.first_name}

// ❌ Using plural module names
useModuleRetrieve('customers', id, {...})

// ❌ Not refreshing after actions
const handleUpdate = async () => {
  await updateAPI(...);
  // Missing: await refreshData();
};
```

