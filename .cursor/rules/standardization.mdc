### Complete Examples

#### OrderView Example

```javascript
"use client";
import React, { useMemo } from "react";
import { useRouter } from "next/navigation";
import { useModuleRetrieve } from "../../../hooks/useModuleRetrieve";
import { ContentLoadingScreen } from "../../../components/ContentLoadingScreen";

export function OrderView({ orderId }) {
  const router = useRouter();

  // Fetch order with all relations
  const { 
    data: order, 
    loading, 
    error: fetchError, 
    refreshData 
  } = useModuleRetrieve('order', orderId, {
    expand: ['customer', 'items', 'pricing', 'items.pricing']
  });

  // Sort pricing components
  const sortedPricing = useMemo(() => {
    const components = Array.isArray(order?.pricing) 
      ? order.pricing 
      : order?.pricing?.components;
    
    if (!components) return [];
    
    const sortOrder = {
      'subtotal': 1, 'discount': 2, 'shipping': 3,
      'payment': 4, 'tip': 5, 'total': 6
    };
    
    return [...components].sort((a, b) => 
      (sortOrder[a.component] || 99) - (sortOrder[b.component] || 99)
    );
  }, [order?.pricing]);

  if (loading) return <ContentLoadingScreen />;
  if (fetchError || !order) return <ErrorDisplay error={fetchError} />;

  return (
    <PageContainer>
      <DashboardHeader title={order?.name} />
      
      {/* Order Items - already includes pricing */}
      {order.items?.map(item => (
        <Box key={item.id}>
          <Typography>{item.product_title}</Typography>
          <Typography>{item.pricing?.price}</Typography>
        </Box>
      ))}
      
      {/* Pricing Breakdown */}
      {sortedPricing.map(pricing => (
        <TableRow key={pricing.component}>
          <TableCell>{pricing.component}</TableCell>
          <TableCell>{pricing.gross_local}</TableCell>
        </TableRow>
      ))}
      
      {/* Customer - expanded */}
      <Typography>{order.customer?.first_name} {order.customer?.last_name}</Typography>
      
      {/* Addresses - use _log fields */}
      <Typography>{order.billing_address_log?.address}</Typography>
      <ShippingAddressCard address={order.shipping_address_log} />
    </PageContainer>
  );
}
```

#### CustomerView Example

```javascript
"use client";
import React, { useMemo } from "react";
import { useRouter } from "next/navigation";
import { useModuleRetrieve } from "../../../hooks/useModuleRetrieve";
import { ContentLoadingScreen } from "../../../components/ContentLoadingScreen";

export function CustomerView({ customerId }) {
  const router = useRouter();

  // Fetch customer with addresses and orders
  const { 
    data: customer, 
    loading, 
    error: fetchError, 
    refreshData 
  } = useModuleRetrieve('customer', customerId, {
    expand: ['billing_addresses', 'shipping_addresses', 'orders']
  });

  // Extract default billing address
  const billingAddress = useMemo(() => {
    if (!customer?.billing_addresses?.length) return null;
    return customer.billing_addresses.find(addr => addr.id === customer.default_billing)
      || customer.billing_addresses[0];
  }, [customer]);

  // Extract default shipping address
  const shippingAddress = useMemo(() => {
    if (!customer?.shipping_addresses?.length) return null;
    return customer.shipping_addresses.find(addr => addr.id === customer.default_shipping)
      || customer.shipping_addresses[0];
  }, [customer]);

  // Get recent orders (limit to 5)
  const recentOrders = useMemo(() => {
    return customer?.orders?.slice(0, 5) || [];
  }, [customer?.orders]);

  if (loading) return <ContentLoadingScreen />;
  if (fetchError || !customer) return <ErrorDisplay error={fetchError} />;

  return (
    <PageContainer>
      <DashboardHeader 
        title={`${customer?.first_name} ${customer?.last_name}`}
      />
      
      {/* Customer Info */}
      <Typography>{customer.email}</Typography>
      
      {/* Billing Address */}
      {billingAddress && (
        <Box>
          <Typography>{billingAddress.address}</Typography>
          <Typography>{billingAddress.city}, {billingAddress.zip}</Typography>
        </Box>
      )}
      
      {/* Shipping Address */}
      <ShippingAddressCard address={shippingAddress} />
      
      {/* Recent Orders */}
      {recentOrders.map(order => (
        <Box key={order.id}>
          <Typography>{order.name}</Typography>
        </Box>
      ))}
    </PageContainer>
  );
}
```

